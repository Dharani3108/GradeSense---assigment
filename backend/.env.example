# Copy to backend/.env. Every value here has a working default, so the app runs
# with no .env file at all - see README.md.

PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/gradesense.sqlite
UPLOAD_ROOT=./uploads

# --- Grading model -----------------------------------------------------------
# auto (default) uses Gemini when GEMINI_API_KEY is set, and the offline
# reference grader otherwise. Force one with: gemini | mock
LLM_PROVIDER=auto
# Never commit a real key. Leave blank to use the offline grader.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT_MS=45000
LLM_MAX_ATTEMPTS=3

# --- Text extraction ---------------------------------------------------------
# auto (default) uses Cloud Vision when credentials are set, otherwise reads the
# PDF text layer. Force one with: vision | pdf-text | mock
OCR_PROVIDER=auto
# Absolute path to a Google Cloud service-account JSON key. Required only to
# read scans and photographs; PDFs with a text layer need nothing.
GOOGLE_APPLICATION_CREDENTIALS=

# --- Guard rails -------------------------------------------------------------
# Reports below this blended confidence are flagged for human review.
REVIEW_CONFIDENCE_THRESHOLD=70
# Answers shorter than this are treated as blank and never sent to the model.
BLANK_ANSWER_MIN_CHARS=40
MAX_UPLOAD_BYTES=10485760
